# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so your real keys never get committed.

# Supabase (Project Settings -> Data API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Random secret used to encrypt users' AI provider API keys before storing
# them in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=
